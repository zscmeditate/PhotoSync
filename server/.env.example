# PhotoSync server 环境变量示例（本地开发用；docker-compose 场景见根目录 .env.example）

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL 连接串
DATABASE_URL=postgresql://photosync:photosync@localhost:5432/photosync?schema=public

# JWT 签名密钥（至少 16 个字符）
JWT_SECRET=change-me-to-a-long-random-secret
# 访问令牌有效期（jsonwebtoken expiresIn 语法，如 15m）
ACCESS_TOKEN_TTL=15m
# 刷新令牌有效期（天）
REFRESH_TOKEN_TTL_DAYS=30

# S3 / MinIO 对象存储（Phase 1 仅预留配置，未实现上传路由）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=photosync
