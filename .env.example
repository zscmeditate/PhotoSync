# PhotoSync docker-compose 环境变量示例
# 复制为 .env 后按需修改（compose 会自动读取 .env）

# ---- PostgreSQL ----
POSTGRES_USER=photosync
POSTGRES_PASSWORD=photosync
POSTGRES_DB=photosync

# ---- MinIO / S3 兼容对象存储 ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=photosync
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# 固定上传分片大小（字节），默认 8 MiB
UPLOAD_PART_SIZE=8388608

# ---- Server ----
# 服务器内部使用的数据库连接串（docker-compose 内会自动拼接，见 docker-compose.yml）
# DATABASE_URL=postgresql://photosync:photosync@postgres:5432/photosync?schema=public
# JWT 签名密钥，至少 16 个字符，生产环境务必改成强随机值
JWT_SECRET=change-me-to-a-long-random-secret
# 访问令牌有效期（jsonwebtoken expiresIn 语法）
ACCESS_TOKEN_TTL=15m
# 刷新令牌有效期（天）
REFRESH_TOKEN_TTL_DAYS=30
